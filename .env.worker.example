# The supervised `worker` Compose service's only secrets file. Copy to `.env.worker` (mode
# 0600) next to compose.yaml on the deploy host; never merge these values into `.env.app`
# (`.env.app.example`'s own rule -- "Keep SSH/Groq keys in .env, never in this file" -- stays
# intact). Unlike the operator's local `.env`, this file never carries DEPLOY_SSH_* values and is
# safe to keep on the deploy host itself: it is not the same file, and it is never transferred
# from the operator's machine.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_TIMEOUT_SECONDS=180
