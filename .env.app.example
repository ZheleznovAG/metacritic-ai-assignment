# Application-only settings. Keep SSH/Groq keys in .env, never in this file.
# scripts/init_env.py creates .env.app with random local credentials.
APP_ENV=local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=false
POSTGRES_DB=metacritic
POSTGRES_USER=metacritic
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
# POSTGRES_USER/PASSWORD are for provisioning only, never passed to web.
WEB_DB_USER=metacritic_web
WEB_DB_PASSWORD=
MIGRATE_DB_USER=metacritic_migrate
MIGRATE_DB_PASSWORD=
CHECKS_DB_USER=metacritic_checks
CHECKS_DB_PASSWORD=
SCHEDULER_DB_USER=metacritic_scheduler
SCHEDULER_DB_PASSWORD=
WORKER_DB_USER=metacritic_worker
WORKER_DB_PASSWORD=
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=18081
APP_VERSION=local
