# SPK-06 SSH access. Copy to .env and keep the private key outside Git.
SPK06_SSH_HOST=
SPK06_SSH_PORT=22
SPK06_SSH_USER=
SPK06_SSH_KEY_PATH=.secrets/spk06_ssh_key

# SPK-05 Groq Free Plan. Keep this project on the Free Plan (no paid fallback).
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_MODEL=openai/gpt-oss-20b
GROQ_API_TIMEOUT_SECONDS=180
SPK05_MAX_RETRIES=3
